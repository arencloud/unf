ARG RUST_IMAGE=docker.io/library/rust:1.95-bookworm
ARG TEST_TOOLS_IMAGE=quay.io/arencloud/unf-test-tools-dev@sha256:e9cce439d92d0f7d3d6751f234e397a7efc29f9983bc0ae8fc318432c4ff2352
FROM ${RUST_IMAGE} AS builder
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY bins ./bins
COPY ebpf/unf-ebpf-common ./ebpf/unf-ebpf-common
RUN cargo build --locked --release --package unf-cni --example disposable_lifecycle

FROM ${TEST_TOOLS_IMAGE}
ARG UNF_SOURCE_REVISION
LABEL org.opencontainers.image.revision=${UNF_SOURCE_REVISION}
COPY --from=builder /src/target/release/examples/disposable_lifecycle /usr/local/bin/disposable-lifecycle
COPY hack/verify-cni-workload-ownership.sh /usr/local/bin/verify-cni-workload-ownership
ENTRYPOINT ["bash", "/usr/local/bin/verify-cni-workload-ownership"]
