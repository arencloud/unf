FROM docker.io/library/debian:bookworm-slim AS probe-builder

RUN apt-get update \
    && apt-get install --yes --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

COPY images/ipv6-extension-probe.c /tmp/ipv6-extension-probe.c
COPY images/bpf-map-pressure.c /tmp/bpf-map-pressure.c
COPY images/http-flow-receiver.c /tmp/http-flow-receiver.c
RUN gcc -std=c11 -O2 -Wall -Wextra -Werror \
    -o /usr/local/bin/unf-ipv6-extension-probe /tmp/ipv6-extension-probe.c \
    && gcc -std=c11 -O2 -Wall -Wextra -Werror \
    -o /usr/local/bin/unf-bpf-map-pressure /tmp/bpf-map-pressure.c \
    && gcc -std=c11 -O2 -Wall -Wextra -Werror \
    -o /usr/local/bin/unf-flow-receiver /tmp/http-flow-receiver.c

FROM docker.io/library/debian:bookworm-slim

RUN apt-get update \
    && apt-get install --yes --no-install-recommends bpftool iproute2 socat wget \
    && rm -rf /var/lib/apt/lists/*

COPY --from=probe-builder /usr/local/bin/unf-ipv6-extension-probe \
  /usr/local/bin/unf-ipv6-extension-probe
COPY --from=probe-builder /usr/local/bin/unf-bpf-map-pressure \
  /usr/local/bin/unf-bpf-map-pressure
COPY --from=probe-builder /usr/local/bin/unf-flow-receiver \
  /usr/local/bin/unf-flow-receiver

ENTRYPOINT ["/usr/bin/socat"]
